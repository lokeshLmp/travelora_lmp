# Each service reads its own .env file. Copy the matching example and fill in real values:
#   server/.env.example           -> server/.env           (Node.js API)
#   booking-service/.env.example  -> booking-service/.env  (Java Spring Boot)
#   client/.env.example           -> client/.env           (optional)
# Real .env files are ignored by Git and must NEVER be committed.
#
# Reference of the variables used by the project (placeholders only):
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
NODE_ENV=development
JAVA_BOOKING_SERVICE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=*
