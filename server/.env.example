# Copy to server/.env (this folder) and fill in real values. NEVER commit server/.env.
# Without MONGODB_URI the API runs in Academic Demo Mode (local data only).
#
# Atlas format: mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority
# Replace the WHOLE placeholder including the < and > characters.
MONGODB_URI=mongodb://127.0.0.1:27017/travelora
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
NODE_ENV=development

# URL of the Java Spring Boot booking service (no trailing slash).
# Local:  http://localhost:8081
# Render: https://<your-booking-service>.onrender.com
JAVA_BOOKING_SERVICE_URL=http://localhost:8081
