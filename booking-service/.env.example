# Copy this file to ".env" (same folder) and replace the placeholders.
# Do NOT put quotes around values. Never commit the real .env file.
#
# Atlas example format:
# mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority
# Replace the WHOLE placeholder including the < and > characters.
# If the password contains special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=mongodb://localhost:27017/travelora
PORT=8081
CORS_ALLOWED_ORIGINS=*
